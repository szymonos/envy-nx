{
  "description": "Manifest of review shards for the /review skill. Every tracked file is owned by exactly one shard unless `skip` or `unowned_ok` matches it; when several shards' globs match a file, the most specific glob (most literal characters) owns it. See design/reviews/README.md.",
  "skip": [
    "modules/aliases-git/*",
    "modules/aliases-kubectl/*",
    "modules/do-*",
    "modules/psm-windows/*",
    "tests/pester/ConvertCfg.Tests.ps1",
    "tests/pester/ConvertPEM.Tests.ps1",
    "tests/pester/GetLogLine.Tests.ps1",
    "tests/pester/InvokeCommandRetry.Tests.ps1",
    "tests/pester/JoinStr.Tests.ps1",
    ".assets/config/shell_cfg/completions.*",
    "uv.lock"
  ],
  "unowned_ok": [
    "docs/*",
    "design/*",
    "*.md",
    "LICENSE",
    "mkdocs.yml",
    "project-words.txt",
    ".gitattributes",
    ".gitignore",
    ".editorconfig"
  ],
  "shards": [
    {
      "name": "orchestration",
      "title": "Setup orchestration, uninstall and the upgrade walk",
      "charter": "design/reviews/charters/orchestration.md",
      "blast_radius": "high",
      "owns": [
        "nix/setup.sh",
        "nix/uninstall.sh",
        "nix/lib/io.sh",
        "nix/lib/phases/*",
        ".github/scripts/upgrade_walk.sh",
        "tests/bats/test_nix_setup*.bats",
        "tests/bats/test_setup*.bats",
        "tests/bats/test_bootstrap*.bats",
        "tests/bats/test_uninstall*.bats",
        "tests/bats/test_upgrade*.bats"
      ],
      "context": []
    },
    {
      "name": "scopes",
      "title": "Scope definitions, nix packages and per-scope configure scripts",
      "charter": "design/reviews/charters/scopes.md",
      "blast_radius": "high",
      "owns": [
        ".assets/lib/scopes.*",
        ".assets/lib/vscode.sh",
        "nix/flake.nix",
        "nix/nixpkgs_rev.json",
        "nix/scopes/*",
        "nix/configure/*",
        "modules/utils-setup/Functions/scopes.ps1",
        "tests/nix/*",
        "tests/bats/test_*_configure.bats",
        "tests/bats/test_*_remove.bats",
        "tests/pester/Scopes.Tests.ps1",
        "tests/bats/test_scopes*.bats"
      ],
      "context": [
        "nix/lib/phases/scopes.sh",
        "nix/lib/phases/configure.sh"
      ]
    },
    {
      "name": "nx-core",
      "title": "nx dispatcher, helpers, surface and completers",
      "charter": "design/reviews/charters/nx-core.md",
      "blast_radius": "high",
      "owns": [
        ".assets/lib/nx.sh",
        ".assets/lib/nx_*.sh",
        ".assets/lib/nx_surface.json",
        ".assets/lib/helpers.sh",
        "tests/hooks/gen_nx_completions.py",
        "tests/bats/test_nx_*.bats",
        "tests/pester/Nx*.Tests.ps1",
        "tests/bats/test_completions*.bats",
        "tests/bats/test_*helpers*.bats",
        "tests/bats/test_pwsh_nop*.bats"
      ],
      "context": [
        ".assets/config/pwsh_cfg/_aliases_nix.ps1"
      ]
    },
    {
      "name": "nx-packages",
      "title": "nx package, scope and lifecycle verbs, overlays",
      "charter": "design/reviews/charters/nx-packages.md",
      "blast_radius": "high",
      "owns": [
        ".assets/lib/nx_pkg.sh",
        ".assets/lib/nx_scope.sh",
        ".assets/lib/nx_lifecycle.sh",
        "tests/bats/test_nx_pkg*.bats",
        "tests/bats/test_nx_scope*.bats",
        "tests/bats/test_overlay*.bats"
      ],
      "context": [
        ".assets/lib/nx.sh",
        ".assets/lib/scopes.sh",
        "tests/bats/test_nx_commands.bats"
      ]
    },
    {
      "name": "doctor-profile",
      "title": "nx doctor, managed profile blocks and the install record",
      "charter": "design/reviews/charters/doctor-profile.md",
      "blast_radius": "high",
      "owns": [
        ".assets/lib/nx_doctor.sh",
        ".assets/lib/nx_profile.sh",
        ".assets/lib/profile_block.sh",
        ".assets/lib/install_record.sh",
        ".assets/lib/setup_log.sh",
        "tests/bats/test_nx_doctor*.bats",
        "tests/bats/test_profile*.bats",
        "tests/bats/test_install_record*.bats"
      ],
      "context": [
        "nix/configure/profiles.sh",
        "nix/configure/profiles.zsh",
        "nix/configure/profiles.ps1",
        "nix/lib/phases/profiles.sh",
        ".assets/config/pwsh_cfg/_aliases_nix.ps1",
        "tests/bats/test_nx_commands.bats"
      ]
    },
    {
      "name": "certs",
      "title": "Certificate and proxy path",
      "charter": "design/reviews/charters/certs.md",
      "blast_radius": "high",
      "owns": [
        ".assets/lib/certs.sh",
        ".assets/lib/cert_probe.sh",
        ".assets/fix/fix_*_certs.sh",
        "wsl/wsl_certs_add.ps1",
        "tests/bats/test_*cert*.bats"
      ],
      "context": [
        ".assets/lib/nx_profile.sh",
        "nix/lib/phases/nix_profile.sh",
        "nix/configure/nodejs.sh",
        ".assets/setup/setup_profile_user.ps1"
      ]
    },
    {
      "name": "shell-config",
      "title": "Shell, PowerShell and prompt config, user setup scripts",
      "charter": "design/reviews/charters/shell-config.md",
      "blast_radius": "medium",
      "owns": [
        ".assets/config/*",
        ".assets/setup/*",
        "tests/pester/AzLoginSetup.Tests.ps1",
        "tests/bats/test_*aliases*.bats",
        "tests/bats/test_functions*.bats"
      ],
      "context": [
        ".assets/lib/nx_profile.sh"
      ]
    },
    {
      "name": "system-installers",
      "title": "Root-required installers, linux_setup.sh and host scripts",
      "charter": "design/reviews/charters/system-installers.md",
      "blast_radius": "high",
      "owns": [
        ".assets/provision/*",
        ".assets/scripts/*",
        ".assets/check/*",
        ".assets/fix/*",
        "tests/bats/test_install_*.bats",
        "tests/bats/test_linux_setup*.bats"
      ],
      "context": []
    },
    {
      "name": "wsl",
      "title": "WSL orchestration from the Windows host",
      "charter": "design/reviews/charters/wsl.md",
      "blast_radius": "medium",
      "owns": [
        "wsl/*",
        "modules/utils-setup/*",
        "modules/utils-install/*",
        "tests/pester/WslSetup*.Tests.ps1",
        "tests/pester/_helpers/*"
      ],
      "context": []
    },
    {
      "name": "hooks",
      "title": "Pre-commit gate scripts",
      "charter": "design/reviews/charters/hooks.md",
      "blast_radius": "medium",
      "owns": [
        "tests/hooks/check_*.py",
        "tests/hooks/validate_*.py",
        "tests/hooks/gremlins.py",
        "tests/hooks/align_tables.py",
        "tests/hooks/_file_scopes.py",
        "tests/bats/test_check_*.bats",
        "tests/bats/test_validate_*.bats"
      ],
      "context": [
        ".pre-commit-config.yaml"
      ]
    },
    {
      "name": "test-harness",
      "title": "Test runners, generators, Makefile and lint config",
      "charter": "design/reviews/charters/test-harness.md",
      "blast_radius": "medium",
      "owns": [
        "tests/hooks/*",
        "tests/bats/diagnose.sh",
        "tests/bats/test_codify_learnings.bats",
        ".assets/docker/*",
        "Makefile",
        "pyproject.toml",
        ".pre-commit-config.yaml",
        ".cspell.json",
        ".markdownlint.yml",
        ".shellcheckrc",
        "tests/bats/*.bats",
        "tests/pester/*.Tests.ps1"
      ],
      "context": []
    },
    {
      "name": "ci",
      "title": "GitHub workflows, CI scripts and release build",
      "charter": "design/reviews/charters/ci.md",
      "blast_radius": "medium",
      "owns": [
        ".github/workflows/*",
        ".github/scripts/*",
        ".assets/tools/*"
      ],
      "context": [
        "Makefile"
      ]
    },
    {
      "name": "agent-tooling",
      "title": "Agent skills, subagents and rules",
      "charter": "design/reviews/charters/agent-tooling.md",
      "blast_radius": "low",
      "owns": [
        ".claude/skills/*",
        ".claude/agents/*",
        ".claude/rules/*",
        "tests/skills/*",
        "tests/bats/test_release*.bats",
        "tests/bats/test_review*.bats"
      ],
      "context": []
    },
    {
      "name": "enterprise-readiness",
      "title": "Enterprise readiness posture (a lens over docs and extension points)",
      "charter": "design/reviews/charters/enterprise-readiness.md",
      "blast_radius": "medium",
      "owns": [
        "docs/enterprise.md",
        "docs/benefits.md",
        "docs/customization.md",
        "docs/proxy.md",
        "docs/releasing.md"
      ],
      "context": [
        ".assets/lib/install_record.sh",
        ".assets/lib/nx_doctor.sh",
        ".assets/lib/nx_lifecycle.sh",
        "nix/lib/phases/platform.sh",
        "nix/uninstall.sh"
      ]
    }
  ]
}
